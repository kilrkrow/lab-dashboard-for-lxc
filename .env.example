# Haven Lab broker — copy to .env and fill in your values

# GitHub — two-token model recommended
# RO: list repos / issues / PRs (can be Portainer RO classic, or fine-grained read)
GITHUB_USER=kilrkrow
GITHUB_TOKEN=
# GITHUB_RO_TOKEN=          # optional alias for GITHUB_TOKEN
# RW: Save-to-GitHub only (fine-grained Contents:Write on the config repo, e.g. homelab-stacks)
# GITHUB_WRITE_TOKEN=

# UniFi (same shape as UniFiHUD — API key preferred)
# Host only (192.168.1.1) or full URL (https://192.168.1.1)
UNIFI_HOST=
UNIFI_API_KEY=
UNIFI_USER=
UNIFI_PASS=
UNIFI_SITE=
# Optional: force API prefix. Blank = auto-try /proxy/network then classic.
# UNIFI_API_PREFIX=/proxy/network

# Proxmox
PROXMOX_HOST=
PROXMOX_TOKENID=
PROXMOX_SECRET=
PROXMOX_NODE=pve

# AdGuard Home
ADGUARD_HOST=
ADGUARD_USER=admin
ADGUARD_PASS=

# Uptime Kuma — optional, feeds the tile status dots (/api/status).
# Without it the broker probes each service tile itself.
# KUMA_URL=http://kuma.haven:3001
# KUMA_API_KEY=

# Lab health light (/api/lab) — all optional, read-only tokens only.
# Proxmox uses the PROXMOX_* values above (token user needs the PVEAuditor role on /).
# Proxmox Backup Server: token user needs the Audit role on /
# PBS_HOST=https://pbs.haven:8007
# PBS_TOKENID=dashboard@pbs!dashboard
# PBS_SECRET=
# Portainer: access token of a non-admin user given access to each environment
# PORTAINER_HOST=https://portainer.haven:9443
# PORTAINER_TOKEN=
# Guests or containers that are off on purpose (names or PVE vmids, comma-separated)
# LAB_EXPECTED_STOPPED=sandbox,119
# Optional thresholds: LAB_STORAGE_WARN=80 LAB_STORAGE_BAD=92 LAB_BACKUP_MAX_AGE_H=26 LAB_VERIFY_MAX_AGE_D=14

# Broker
CONFIG_PATH=/etc/haven/config.json
PORT=3000
